tamps are omitted from this focused view." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#43515b;" vertex="1" parent="1"><mxGeometry x="30" y="1215" width="1440" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>