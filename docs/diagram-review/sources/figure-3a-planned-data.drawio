<mxfile host="app.diagrams.net"><diagram name="Figure 3A - Proposed data extension" id="Figure 3A - Proposed data extension"><mxGraphModel dx="1450" dy="1140" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1450" pageHeight="1140" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" style="" /><mxCell id="1" parent="0" style="" /><mxCell id="title" value="Figure 3A. Proposed Data Extension" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;text;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=28;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1380" height="45" as="geometry" /></mxCell><mxCell id="scope" value="PLANNED - conceptual entities and fields, not current Django models | PK / FK / UQ | cardinalities on each link" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#43515b;" vertex="1" parent="1"><mxGeometry x="20" y="65" width="1410" height="50" as="geometry" /></mxCell><mxCell id="owner" value="Owner (proposed)&#10;PK id; UQ (issuer, subject)&#10;Maps validated identity token" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#547083;strokeWidth=1.5;align=left;fontSize=18;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="145" width="360" height="145" as="geometry" /></mxCell><mxCell id="deck" value="Deck (existing + proposed owner)&#10;PK id; FK owner_id [new]&#10;UQ owner + hash + prep version" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#547083;strokeWidth=1.5;align=left;fontSize=18;spacing=16;" vertex="1" parent="1"><mxGeometry x="530" y="145" width="390" height="145" as="geometry" /></mxCell><mxCell id="attempt" value="Attempt (existing)&#10;PK id; FK deck_id&#10;Transcript / visits stay here" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#547083;strokeWidth=1.5;align=left;fontSize=18;spacing=16;" vertex="1" parent="1"><mxGeometry x="1050" y="145" width="360" height="145" as="geometry" /></mxCell><mxCell id="deletion" value="DeletionOperation (proposed)&#10;PK id; FK owner_id&#10;target_type / target_uuid&#10;state; file manifest; progress&#10;Target UUID survives row deletion" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#547083;strokeWidth=1.5;align=left;fontSize=18;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="460" width="390" height="210" as="geometry" /></mxCell><mxCell id="selection" value="AttemptSelection (proposed)&#10;PK/FK attempt_id (one per new attempt)&#10;selected_slide_indexes: JSON&#10;source_attempt_id: FK, nullable&#10;Freeze original indexes; keep repeats&#10;Legacy attempts may have no row" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#547083;strokeWidth=1.5;align=left;fontSize=18;spacing=16;" vertex="1" parent="1"><mxGeometry x="510" y="460" width="420" height="230" as="geometry" /></mxCell><mxCell id="summary" value="SummaryRun (proposed)&#10;PK id; FK attempt_id&#10;generation / state / transcript digest&#10;selection digest; provider / model&#10;prompt version; per-visit summaries&#10;Word evidence + failure state" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#547083;strokeWidth=1.5;align=left;fontSize=18;spacing=16;" vertex="1" parent="1"><mxGeometry x="1010" y="460" width="400" height="230" as="geometry" /></mxCell><mxCell id="delivery" value="DeliveryRun (proposed)&#10;PK id; FK attempt_id&#10;generation / state / source digest&#10;rule version; metric availability&#10;Rates + timed filler / pause events&#10;Visit IDs reference Attempt JSON" style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;rounded=1;arcSize=8;fillColor=#ffffff;strokeColor=#547083;strokeWidth=1.5;align=left;fontSize=18;spacing=16;" vertex="1" parent="1"><mxGeometry x="1010" y="825" width="400" height="230" as="geometry" /></mxCell><mxCell id="e1" value="1 owner : 0..* decks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#526777;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontColor=#243744;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="owner" target="deck"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="1 deck : 0..* attempts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#526777;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontColor=#243744;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="deck" target="attempt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="1 owner : 0..* operations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#526777;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontColor=#243744;labelBackgroundColor=#ffffff;entryX=0.45;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="owner" target="deletion"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="1 attempt : 0..1 selection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#526777;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontColor=#243744;labelBackgroundColor=#ffffff;entryX=1;entryY=0.2;entryDx=0;entryDy=0;exitX=0.1;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="attempt" target="selection"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="370" /><mxPoint x="960" y="370" /><mxPoint x="960" y="505" /></Array></mxGeometry></mxCell><mxCell id="e5" value="1 attempt : 0..* runs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#526777;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontColor=#243744;labelBackgroundColor=#ffffff;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="attempt" target="summary"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="1 attempt : 0..* runs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#526777;strokeWidth=1.5;fontFamily=Arial;fontSize=16;fontColor=#243744;labelBackgroundColor=#ffffff;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.7;exitDx=0;exitDy=0;" edge="1" parent="1" source="attempt" target="delivery"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="245" /><mxPoint x="1440" y="930" /></Array></mxGeometry></mxCell><mxCell id="notes" value="Planned persistence decisions&#10;Runs retain independent state and source versions; a failed analysis never replaces the transcript.&#10;Selection records refer to original deck indexes; repeated visits remain in Attempt JSON.&#10;Deletion blocks new work, cleans dependent rows in order, then retries file cleanup from a durable manifest.&#10;Descriptions remain deck-scoped. Existing coaching snapshots need a practiced-scope projection (Section 8.3)." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontColor=#1e2e38;spacing=10;text;strokeColor=none;fillColor=none;align=lef