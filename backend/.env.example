DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,testserver
POSTGRES_DB=outloud
POSTGRES_USER=outloud
POSTGRES_PASSWORD=outloud-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Hosted ElevenLabs Scribe v2; separate from all text/image LLM requests.
# Processing retries are manual; ambiguous requests require charge acknowledgement.
ELEVENLABS_API_KEY=
# OpenRouter key only. Exclude personal OpenAI BYOK credentials in its workspace/key.
OPENROUTER_API_KEY=
# Disabled until configured. Existing automatic initial-generation workflows remain.
# No provider fallback; mobile asserts the disclosed nonsecret selection.
FEEDBACK_ENABLED=false
FEEDBACK_PROVIDER=openrouter
FEEDBACK_OPENROUTER_MODEL=openai/gpt-6-luna
# Nonsecret account/workspace label binds durable scopes; never put a key here.
FEEDBACK_OPENROUTER_PROJECT_ID=
# REQUIRED positive application allowances; no provider-tier defaults.
# TPM reserves UTF-8 request bytes + maximum output tokens, NOT exact tokens.
FEEDBACK_OPENROUTER_RPM=
FEEDBACK_OPENROUTER_TPM=
# Optional positive request/day ceiling; blank disables it. Resets at midnight UTC.
FEEDBACK_OPENROUTER_DAILY_REQUEST_LIMIT=

# Legacy provider configuration is explicit, never a fallback for OpenRouter.
# Historical results/receipts retain these identities; cutover blocks old submissions.
OPENAI_API_KEY=
FEEDBACK_OPENAI_MODEL=gpt-6-luna
FEEDBACK_OPENAI_PROJECT_ID=
FEEDBACK_OPENAI_RPM=
FEEDBACK_OPENAI_TPM=
FEEDBACK_OPENAI_DAILY_REQUEST_LIMIT=
GEMINI_API_KEY=
FEEDBACK_GEMINI_MODEL=gemini-3.1-flash-lite
FEEDBACK_GEMINI_PROJECT_ID=
FEEDBACK_GEMINI_RPM=
FEEDBACK_GEMINI_TPM=
# Gemini's legacy daily policy uses America/Los_Angeles midnight.
FEEDBACK_GEMINI_DAILY_REQUEST_LIMIT=
