DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,testserver
POSTGRES_DB=outloud
POSTGRES_USER=outloud
POSTGRES_PASSWORD=outloud-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Hosted whisper-1 only. Upload and no-speech checks need no provider key.
# Processing retries are manual; ambiguous requests require charge acknowledgement.
OPENAI_API_KEY=
# Checkpoint 2: explicit deck-description generation only; attempt feedback stays disabled.
# Exact true/false. No upload/transcription-triggered calls or provider fallback.
FEEDBACK_ENABLED=false
FEEDBACK_PROVIDER=gemini
FEEDBACK_GEMINI_MODEL=gemini-3.1-flash-lite
FEEDBACK_OPENAI_MODEL=gpt-6-luna
GEMINI_API_KEY=

# Nonsecret project identities bind durable scopes and shared model quota buckets.
# Configure the actual project for each key. Key rotation within a project is OK.
FEEDBACK_GEMINI_PROJECT_ID=
FEEDBACK_OPENAI_PROJECT_ID=
# REQUIRED positive application allowances for outbound feedback; no tier defaults.
# TPM reserves UTF-8 request bytes + maximum output tokens, NOT exact provider tokens.
FEEDBACK_GEMINI_RPM=
FEEDBACK_GEMINI_TPM=
FEEDBACK_OPENAI_RPM=
FEEDBACK_OPENAI_TPM=
# Optional positive request/day ceilings; blank disables this application ceiling.
# Gemini: midnight America/Los_Angeles. OpenAI: application-defined midnight UTC.
FEEDBACK_GEMINI_DAILY_REQUEST_LIMIT=
FEEDBACK_OPENAI_DAILY_REQUEST_LIMIT=
