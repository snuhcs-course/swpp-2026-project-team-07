DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,testserver
POSTGRES_DB=outloud
POSTGRES_USER=outloud
POSTGRES_PASSWORD=outloud-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
OPENAI_API_KEY=
GEMINI_API_KEY=
# Local multilingual transcription; no paid fallback.
WHISPER_CPU_THREADS=4
# Optional cache directory; Docker mounts a persistent /models volume.
# WHISPER_CACHE_DIR=/absolute/path/to/model-cache
# Keep off until the operator verifies free-tier billing and actual AI Studio limits.
GEMINI_ENABLED=0
GEMINI_FREE_TIER_CONFIRMED=0
GEMINI_PROJECT_ID=
GEMINI_RPM=0
GEMINI_TPM=0
GEMINI_RPD=0
