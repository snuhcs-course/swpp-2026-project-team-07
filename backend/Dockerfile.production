# AI-assisted deployment configuration, OpenAI Codex, Iteration 2 (2026-10-31).
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt requirements-production.txt ./
RUN pip install --no-cache-dir -r requirements-production.txt \
    && groupadd --gid 10001 outloud \
    && useradd --uid 10001 --gid outloud --no-create-home outloud \
    && mkdir /app/media \
    && chown outloud:outloud /app/media
COPY . .
USER outloud
EXPOSE 8000
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "2", "--timeout", "180", "--error-logfile", "-"]
