# Copy to ignored deploy/.env.public; pass it after deploy/.env via --env-file.
# AI-assisted configuration, OpenAI Codex, Iteration 2 (2026-11-01).
OUTLOUD_PUBLIC_HOST=outloud-team07.koreacentral.cloudapp.azure.com
# Azure NAT forwards the public IP to this primary private NIC address.
OUTLOUD_PUBLIC_BIND_IP=10.0.0.4
# Username is fixed to reviewer. Never store the plaintext demo code here.
# Generate bcrypt from stdin with the pinned Caddy image in compose.public.yaml;
# invoke caddy hash-password without --plaintext (default production bcrypt cost).
# Terminate stdin with a newline; EOF without a newline is rejected.
# Single-quote the resulting hash so Compose preserves every dollar sign.
OUTLOUD_DEMO_PASSWORD_HASH=''
