# Private team deployment only. Copy to ignored deploy/.env with mode 600.
# AI-assisted deployment configuration, OpenAI Codex, Iteration 2 (2026-10-31).
# Run Compose with --env-file deploy/.env -f compose.production.yaml.
OUTLOUD_IMAGE_TAG=team
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=outloud.example-tailnet.ts.net
POSTGRES_DB=outloud
POSTGRES_USER=outloud
POSTGRES_PASSWORD=
# Required only when speech is submitted for transcription.
ELEVENLABS_API_KEY=
# Keep feedback disabled until private provider configuration is deliberately set.
FEEDBACK_ENABLED=false
FEEDBACK_PROVIDER=openrouter
# OpenRouter credits only; exclude personal provider BYOK credentials in its workspace.
OPENROUTER_API_KEY=
FEEDBACK_OPENROUTER_MODEL=openai/gpt-6-luna
# Nonsecret account/workspace label; never use an API key as the project identity.
FEEDBACK_OPENROUTER_PROJECT_ID=
# Required positive application allowances; these do not replace a provider spend cap.
FEEDBACK_OPENROUTER_RPM=
FEEDBACK_OPENROUTER_TPM=
FEEDBACK_OPENROUTER_DAILY_REQUEST_LIMIT=

# Rebuilt feedback pipeline (v3): docs/ai-feedback-reimplementation.md.
# Off by default. Uses OPENROUTER_API_KEY above; independent of FEEDBACK_ENABLED.
FEEDBACK_V3_ENABLED=false
# Start v3 automatically when transcription completes (no app round trip).
FEEDBACK_V3_AUTO_START=false
# Blank uses FEEDBACK_OPENROUTER_MODEL, then openai/gpt-6-luna.
FEEDBACK_V3_MODEL=
# low|medium|high, or blank to omit the reasoning setting.
FEEDBACK_V3_REASONING_EFFORT=low
# Blank omits temperature (some reasoning models reject it).
FEEDBACK_V3_TEMPERATURE=
FEEDBACK_V3_TIMEOUT_SECONDS=60
FEEDBACK_V3_RETRIES=2
FEEDBACK_V3_MAX_PARALLEL=8
