# Copy to deploy/.env.store (chmod 600) in the separate store checkout.
OUTLOUD_STORE_IMAGE_TAG=v42
DJANGO_ALLOWED_HOSTS=outloud-team07.koreacentral.cloudapp.azure.com
DJANGO_SECRET_KEY=
POSTGRES_DB=outloud_store
POSTGRES_USER=outloud_store
POSTGRES_PASSWORD=
# Set the server-side keys for the funded release audience and period.
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
FEEDBACK_ENABLED=false
FEEDBACK_V3_ENABLED=false
FEEDBACK_V3_AUTO_START=false
INCREMENTAL_CAPTURE_ENABLED=false
FEEDBACK_PROVIDER=openrouter
FEEDBACK_OPENROUTER_PROJECT_ID=outloud-store
FEEDBACK_OPENROUTER_MODEL=
FEEDBACK_V3_MODEL=
FEEDBACK_OPENROUTER_RPM=20
# Cue requests include the serialized slide images in their size estimate.
FEEDBACK_OPENROUTER_TPM=30000000
FEEDBACK_OPENROUTER_DAILY_REQUEST_LIMIT=300
# Enter the verified ceilings for the model and Scribe account before enabling AI.
OUTLOUD_PUBLIC_OPENROUTER_MODEL=
OUTLOUD_PUBLIC_OPENROUTER_CONTEXT_TOKENS=
OUTLOUD_PUBLIC_OPENROUTER_INPUT_USD_PER_MTOK=
OUTLOUD_PUBLIC_OPENROUTER_OUTPUT_USD_PER_MTOK=
OUTLOUD_PUBLIC_SCRIBE_USD_PER_HOUR=
# Public calls require a future funding deadline including its UTC offset.
OUTLOUD_PUBLIC_AI_UNTIL=2026-12-12T00:00:00+09:00
