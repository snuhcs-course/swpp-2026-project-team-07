# Public address only. Never put provider API keys in EXPO_PUBLIC variables.
# Android emulator reaches the host computer at 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api

# Startup-only layout selection. Omit for Refactor Design. Restart Metro after changes.
EXPO_PUBLIC_UI_LAYOUT=refactor
# contract-test is available only in development/test builds.
